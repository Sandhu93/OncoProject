# Copy to .env.local (ignored by git). See docs/architecture/web.md.
# The browser never calls the API: every request goes through this app's server. So API_URL is
# read on the server only and is never sent to the browser.

# The OncoTrack API (NestJS), including its /api/v1 prefix.
API_URL=http://127.0.0.1:3000/api/v1

# Public name and address of this web app (no secrets in NEXT_PUBLIC_ variables).
NEXT_PUBLIC_APP_NAME=OncoTrack
NEXT_PUBLIC_APP_URL=http://localhost:5173

# Optional. Header holding the visitor's address when a reverse proxy sits in front of this app
# (for example x-real-ip with nginx). It is forwarded to the API. Leave empty without such a proxy.
TRUSTED_CLIENT_IP_HEADER=

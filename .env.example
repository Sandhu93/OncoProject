# Reference only. npm run env:init generates an ignored .env with a random password.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
# Days a chart may wait in a stage before it shows as stalled (not in treatment). Still to be confirmed (D-07).
STALL_DAYS=3
# Minutes between reminder checks (stalled charts, Saturday updates). 0 switches them off.
NOTIFICATION_SWEEP_MINUTES=15
# Sign in with the hospital directory (LDAP). Off unless DIRECTORY_URL is set. Prefer ldaps://; ldap:// needs
# DIRECTORY_START_TLS=true. The password is checked by binding as the person, so no service account is needed.
# DIRECTORY_URL=ldaps://directory.hospital.local
# DIRECTORY_BIND_DN=uid={username},ou=staff,dc=hospital,dc=local
# DIRECTORY_CA_FILE=/etc/ssl/certs/hospital-ca.pem
# DIRECTORY_TIMEOUT_MS=5000
POSTGRES_USER=oncotrack_dev
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_DB=oncotrack_dev
DATABASE_URL=postgresql://oncotrack_dev:replace-with-a-random-local-password@127.0.0.1:5432/oncotrack_dev
TEST_DATABASE_URL=postgresql://oncotrack_dev:replace-with-a-random-local-password@127.0.0.1:5433/oncotrack_test

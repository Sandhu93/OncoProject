# Reference only. npm run env:init generates an ignored .env with a random password.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
POSTGRES_USER=oncotrack_dev
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_DB=oncotrack_dev
DATABASE_URL=postgresql://oncotrack_dev:replace-with-a-random-local-password@127.0.0.1:5432/oncotrack_dev
TEST_DATABASE_URL=postgresql://oncotrack_dev:replace-with-a-random-local-password@127.0.0.1:5433/oncotrack_test
